{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Regex Sweep",
  "version": "0.1.0",
  "identifier": "com.ianbedard.regexsweep",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Regex Sweep",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 680
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
